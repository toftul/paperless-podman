# Copy to secrets.env and fill in. secrets.env is gitignored - never commit it.
#
#   cp secrets.env.example secrets.env
#   sed -i "s/CHANGEME_DB/$(openssl rand -hex 16)/g;s/CHANGEME_SECRET/$(openssl rand -hex 32)/" secrets.env
#   chmod 600 secrets.env

# Database password. The two must be identical: postgres reads the first,
# paperless the second.
POSTGRES_PASSWORD=CHANGEME_DB
PAPERLESS_DBPASS=CHANGEME_DB

# Django secret key.
PAPERLESS_SECRET_KEY=CHANGEME_SECRET

# Superuser created on first start only.
PAPERLESS_ADMIN_USER=ivan
PAPERLESS_ADMIN_PASSWORD=CHANGEME_ADMIN
