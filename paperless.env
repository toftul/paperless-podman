# Non-secret paperless-ngx settings. Edit to taste, then:
#   systemctl --user restart paperless-webserver

# --- connections (must match the quadlet container names) ---
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=paperless-db
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_REDIS=redis://paperless-broker:6379

# --- basics ---
# The URL you actually reach paperless on (needed for CSRF / links in mails).
PAPERLESS_URL=http://apollo.lan:8000
# Use a canonical tz name. Legacy aliases (Australia/ACT, US/Eastern, ...) live
# in Debian's tzdata-legacy package, which is not in the image, and paperless
# refuses to start on them: "Incorrect timezone setting".
PAPERLESS_TIME_ZONE=Australia/Sydney

# --- OCR ---
# PAPERLESS_OCR_LANGUAGE is what tesseract uses; PAPERLESS_OCR_LANGUAGES makes
# the container install the extra language packs at startup.
PAPERLESS_OCR_LANGUAGE=eng
# PAPERLESS_OCR_LANGUAGES=eng rus deu

# --- consume folder behaviour ---
PAPERLESS_CONSUMER_POLLING=0
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true

# Full list of options: https://docs.paperless-ngx.com/configuration/
